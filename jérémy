                      Définition Officielle
                    </h3>
                    <p className="text-base font-medium text-slate-700 bg-slate-50 p-3 rounded-lg border border-slate-100">
                      {selectedLevel.description}
                    </p>
                  </div>

                  {/* Criteria List */}
                  {selectedLevel.criteria.length > 0 && (
                    <div>
                      <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                        <CheckCircle size={14} />
                        Critères Spécifiques
                      </h3>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        {selectedLevel.criteria.map((crit, idx) => (
                          <div key={idx} className="flex items-center gap-2 text-slate-600 text-sm bg-white p-2 rounded border border-slate-100 shadow-sm">
                            <div className="w-1.5 h-1.5 rounded-full bg-green-500"></div>
                            {crit}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Example */}
                  <div className="border-l-4 border-slate-300 pl-4 py-1">
                    <h3 className="text-xs font-bold uppercase tracking-wider text-slate-400">Concrètement</h3>
                    <p className="text-slate-600 italic text-sm">"{selectedLevel.example}"</p>
                  </div>

                  {/* AI Section */}
                  <div className="mt-auto pt-6 border-t border-slate-100">
                    <div className="flex items-center justify-between mb-3">
                      <h3 className="text-xs font-bold uppercase tracking-wider text-indigo-600 flex items-center gap-2">
                        <Bot size={16} />
                        Assistant Formation (IA)
                      </h3>
                    </div>
                    
                    {!scenario && !loadingScenario && (
                      <button 
                        onClick={handleGenerateScenario}
                        className="w-full py-3 rounded-xl border-2 border-dashed border-indigo-200 text-indigo-600 font-semibold hover:bg-indigo-50 transition-colors flex justify-center items-center gap-2"
                      >
                        <Sparkles size={18} />
                        Générer une mise en situation pour ce niveau
                      </button>
                    )}

                    {loadingScenario && (
                      <div className="flex justify-center p-4 text-indigo-600">
                         <Loader2 className="animate-spin" size={24} />
                      </div>
                    )}

                    {scenario && !loadingScenario && (
                      <div className="bg-indigo-50 rounded-xl p-4 border border-indigo-100">
                        <div className="flex gap-3">
                          <div className="mt-1 min-w-[24px]"><Bot size={24} className="text-indigo-600" /></div>
                          <div>
                             <p className="text-slate-700 text-sm whitespace-pre-line mb-2">{scenario}</p>
                             <button onClick={handleGenerateScenario} className="text-xs text-indigo-600 font-bold hover:underline flex items-center gap-1">
                               Autre scénario <ArrowRight size={10} />
                             </button>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>

                </div>
              </div>
            </div>
          </div>
        )}

        {/* MAIN CONTENT: ASSISTANT MODE */}
        {activeTab === 'assistant' && (
          <div className="max-w-2xl mx-auto animate-in fade-in zoom-in-95 duration-300">
            <div className="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
              <div className="bg-slate-900 p-6 text-white">
                <div className="flex items-center gap-3 mb-2">
                  <Sparkles className="text-yellow-400" size={24} />
                  <h2 className="text-xl font-bold">Auto-Diagnostic : {CurrentCategoryData.label}</h2>
                </div>
                <p className="text-slate-300 text-sm">
                  Décrivez vos tâches réelles liées au critère <strong>{CurrentCategoryData.label.toUpperCase()}</strong>. L'IA vous aidera à identifier votre niveau.
                </p>
              </div>

              <div className="p-6">
                <textarea 
                  className="w-full p-4 rounded-xl border-2 border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition-all min-h-[120px] text-slate-700 mb-4 text-sm"
                  placeholder={`Exemple pour ${CurrentCategoryData.label} : ${CurrentCategoryData.levels[2].example}...`}
                  value={userDescription}
                  onChange={(e) => setUserDescription(e.target.value)}
                />

                <div className="flex justify-end">
                  <button
                    onClick={handleAnalyzeTasks}
                    disabled={!userDescription.trim() || loadingAnalysis}
                    className={`
                      px-5 py-2.5 rounded-lg font-bold text-white flex items-center gap-2 text-sm transition-all
                      ${!userDescription.trim() || loadingAnalysis ? 'bg-slate-300' : 'bg-indigo-600 hover:bg-indigo-700'}
                    `}
                  >
                    {loadingAnalysis ? <Loader2 className="animate-spin" size={18} /> : <Sparkles size={18} />}
                    Analyser mon niveau {CurrentCategoryData.label}
                  </button>
                </div>

                {analysisResult && (
                  <div className="mt-6 bg-slate-50 rounded-xl p-5 border border-slate-200 animate-in slide-in-from-bottom-2">
                    <h3 className="text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                      <Bot size={16} className="text-indigo-600" />
                      Résultat
                    </h3>
                    <div className="text-slate-700 text-sm leading-relaxed whitespace-pre-line">
                      {analysisResult}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* MAIN CONTENT: SUMMARY MODE */}
        {activeTab === 'summary' && (
          <div className="max-w-4xl mx-auto animate-in fade-in zoom-in-95 duration-300">
             <div className="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
                {/* Header */}
                <div className="bg-emerald-600 p-6 text-white flex justify-between items-center">
                   <div>
                      <h2 className="text-2xl font-bold flex items-center gap-2">
                        <FileCheck size={24} /> Fiche de Synthèse
                      </h2>
                      <p className="text-emerald-100 opacity-90 text-sm mt-1">
                        Récapitulatif des niveaux validés pour le poste
                      </p>
                   </div>
                   <div className="text-right">
                      <div className="text-sm text-emerald-100 uppercase tracking-wider font-bold">Total Valorisation</div>
                      <div className="text-4xl font-bold">{totalPoints} pts</div>
                   </div>
                </div>

                {/* Table */}
                <div className="p-6">
                   <div className="grid gap-4">
                      {Object.values(DATA).map((cat) => {
                        const selectedLevelId = selections[cat.id];
                        const levelDetails = cat.levels.find(l => l.id === selectedLevelId);
                        const Icon = cat.icon;

                        return (
                          <div key={cat.id} className="flex flex-col md:flex-row items-start md:items-center p-4 rounded-xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-md transition-all">
                             {/* Cat Icon & Name */}
                             <div className="flex items-center gap-3 w-full md:w-1/4 mb-2 md:mb-0">
                                <div className="bg-white p-2 rounded-lg text-slate-500 border border-slate-200">
                                  <Icon size={20} />
                                </div>
                                <span className="font-bold text-slate-700">{cat.label}</span>
                             </div>

                             {/* Level Details */}
                             <div className="flex-1 w-full md:w-auto pl-0 md:pl-4 border-l-0 md:border-l-2 border-slate-200">
                                <div className="flex items-center gap-2 mb-1">
                                  <span className="bg-slate-800 text-white text-xs font-bold px-2 py-0.5 rounded">
                                    Niveau {selectedLevelId}
                                  </span>
                                  <span className="font-bold text-slate-800">{levelDetails.title}</span>
                                </div>
                                <p className="text-sm text-slate-500 truncate">{levelDetails.shortDesc}</p>
                             </div>

                             {/* Points */}
                             <div className="text-right w-full md:w-auto mt-2 md:mt-0">
                                <span className="text-lg font-mono font-bold text-emerald-600">
                                  {levelDetails.points} pts
                                </span>
                             </div>
                          </div>
                        );
                      })}
                   </div>

                   <div className="mt-8 bg-emerald-50 p-6 rounded-xl border border-emerald-100 text-center">
                      <p className="text-emerald-800 font-medium mb-4">
                        Ce profil totalise <strong>{totalPoints} points</strong> de valorisation.
                      </p>
                      <button 
                        onClick={() => window.print()}
                        className="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg font-bold transition-colors inline-flex items-center gap-2 shadow-sm"
                      >
                        <Save size={18} />
                        Imprimer / Sauvegarder la fiche
                      </button>
                   </div>
                </div>
             </div>
          </div>
        )}

      </div>
    </div>
  );
}
