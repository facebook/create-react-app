const firebaseConfig = {
  apiKey: "TU_API_KEY",
  authDomain: "santimove-santiago.firebaseapp.com",
  projectId: "santimove-santiago",
  storageBucket: "santimove-santiago.appspot.com",
  messagingSenderId: "123456789",
  appId: "1:123456789:web:abcdef"
};

const app = initializeApp(firebaseConfig);
export const db = getFirestore(app);

// Función para obtener paradas de concho desde Firestore
export const getParadasConcho = async () => {
  const paradasCol = collection(db, 'rutas_informales');
  const paradasSnapshot = await getDocs(paradasCol);
  return paradasSnapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));

