import { MapContainer, TileLayer, Marker, Popup, Polyline } from 'react-leaflet';
import 'leaflet/dist/leaflet.css';
import L from 'leaflet';

// Fix para iconos de Leaflet en React
delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
  iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
  shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
});

const monorrielIcon = new L.Icon({
  iconUrl: 'https://cdn-icons-png.flaticon.com/512/821356.png',
  iconSize: [35, 35],
});

const conchoIcon = new L.Icon({
  iconUrl: 'https://cdn-icons-png.flaticon.com/512/75/75538.png',
  iconSize: [30, 30],
});

function MapView({ origen, destino, rutaCalculada }) {
  const santiagoCenter = [19.4517, -70.6970]; // Coordenadas centro Santiago

  // Datos simulados del Monorriel - Estación 3 como ejemplo
  const estacionMonorriel = [19.4685, -70.6850];
  const paradaSajoma = [19.4320, -70.7100];

  return (
    <MapContainer center={santiagoCenter} zoom={13} style={{ height: "500px", width: "100%" }}>
      <TileLayer
        url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        attribution='&copy; OpenStreetMap'
      />
      
      {/* Marcador Origen */}
      {origen && <Marker position={origen}><Popup>Tu ubicación</Popup></Marker>}
      
      {/* Marcador Destino */}
      {destino && <Marker position={destino}><Popup>Destino: PUCMM</Popup></Marker>}

      {/* Estación Monorriel */}
      <Marker position={estacionMonorriel} icon={monorrielIcon}>
        <Popup>Monorriel Est. 3 - Pueblo Nuevo</Popup>
      </Marker>

      {/* Parada de Concho */}
      <Marker position={paradaSajoma} icon={conchoIcon}>
        <Popup>Parada Sajoma - Ruta al centro</Popup>
      </Marker>

      {/* Dibujar ruta si existe */}
      {rutaCalculada && <Polyline positions={rutaCalculada} color="blue" />}
    </MapContainer>
  );
}

export default MapView;

import { useState } from 'react';

function RoutePlanner({ setRutaCalculada, setOrigen, setDestino }) {
  const [origenTxt, setOrigenTxt] = useState('');
  const [destinoTxt, setDestinoTxt] = useState('');
  const [resultado, setResultado] = useState(null);

  // Coordenadas hardcodeadas para el demo - Gurabo a PUCMM
  const coordenadas = {
    "gurabo": [19.4320, -70.7100],
    "pucmm": [19.4436, -70.6828],
    "estacion monorriel 3": [19.4685, -70.6850]
  };

  const calcularRuta = () => {
    // Simulamos la lógica de "InterSantiago"
    if (origenTxt.toLowerCase().includes('gurabo') && destinoTxt.toLowerCase().includes('pucmm')) {
      const ruta = [
        coordenadas["gurabo"], // Caminar a Parada Sajoma
        [19.4320, -70.7100], // Parada Sajoma
        [19.4685, -70.6850], // Estación Monorriel 3
        coordenadas["pucmm"]  // PUCMM
      ];
      
      setRutaCalculada(ruta);
      setOrigen(coordenadas["gurabo"]);
      setDestino(coordenadas["pucmm"]);
      
      setResultado({
        tiempo: "32 min",
        costo: "RD$60",
        pasos: [
          "1. Caminar 4 min a Parada Sajoma",
          "2. Tomar concho Ruta Sajoma - 15 min",
          "3. Abordar Monorriel Est. 3 hasta Est. PUCMM - 10 min",
          "4. Caminar 3 min a destino"
        ],
        co2: "1.2 kg CO₂ ahorrado vs. ir en carro privado"
      });
    } else {
      alert("Para el demo, usa: Origen 'Gurabo' y Destino 'PUCMM'");
    }
  };

  return (
    <div className="route-planner">
      <h2>¿A dónde vamos hoy?</h2>
      <input 
        type="text" 
        placeholder="Origen: Ej. Gurabo" 
        value={origenTxt}
        onChange={(e) => setOrigenTxt(e.target.value)}
      />
      <input 
        type="text" 
        placeholder="Destino: Ej. PUCMM" 
        value={destinoTxt}
        onChange={(e) => setDestinoTxt(e.target.value)}
      />
      <button onClick={calcularRuta}>Calcular Ruta InterSantiago</button>

      {resultado && (
        <div className="resultado">
          <h3>Tu mejor ruta: {resultado.tiempo} | {resultado.costo}</h3>
          <ul>

          
            {resultado.pasos.map((paso, i) => <li key={i}>{paso}</li>)}
          </ul>
          <p className="co2"> {resultado.co2}</p>
        </div>
      )}
    </div>
  );
}
